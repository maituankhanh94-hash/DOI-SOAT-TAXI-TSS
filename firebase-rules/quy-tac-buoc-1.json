{
  "rules": {
    "trips": {
      ".read": true,
      ".write": true
    },
    "users_trips": {
      ".read": true,
      ".write": true
    },
    "settings": {
      ".read": true,
      ".write": true
    },
    "deleted_trips": {
      ".read": true,
      ".write": true
    },
    "drivers": {
      ".read": true,
      ".write": true
    },
    "accounts": {
      ".read": true,
      ".write": true
    },
    "roles": {
      ".read": true,
      ".write": true
    },
    "login_index": {
      ".read": true,
      ".write": true
    },
    "places": {
      ".read": true,
      ".write": true
    },
    "meta": {
      ".read": true,
      ".write": true
    },
    "test_env": {
      "login_index": {
        ".read": true,
        "$u": {
          ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || (auth != null && !root.child('test_env/roles').exists())"
        }
      },
      "roles": {
        ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || ((auth != null && !root.child('test_env/roles').exists()) && auth.uid === $uid && newData.child('role').val() === 'manager' && newData.child('active').val() === true)"
        }
      },
      "accounts": {
        ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        "$u": {
          ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || (auth != null && !root.child('test_env/roles').exists())"
        }
      },
      "settings": {
        ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        "accounts": {
          ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')"
        },
        "sources": {
          ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)"
        },
        "staff": {
          ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)"
        },
        "carTypes": {
          ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)"
        },
        "payments": {
          ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)"
        },
        "planPayments": {
          ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)"
        },
        "lockHour": {
          ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)"
        }
      },
      "trips": {
        ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        ".indexOn": [
          "dateKey"
        ],
        "$id": {
          ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || ((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && (!data.exists() || data.child('createdBy').val() === root.child('test_env/roles/'+auth.uid+'/user').val()) && (!newData.exists() || newData.child('createdBy').val() === root.child('test_env/roles/'+auth.uid+'/user').val()))"
        }
      },
      "users_trips": {
        "$user": {
          ".indexOn": [
            "dateKey"
          ],
          ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || ((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && $user === root.child('test_env/roles/'+auth.uid+'/user').val())",
          ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || ((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && $user === root.child('test_env/roles/'+auth.uid+'/user').val())"
        }
      },
      "places": {
        ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)",
        ".indexOn": [
          "n"
        ],
        "$p": {
          ".write": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)",
          ".validate": "newData.hasChildren(['name', 'n']) && newData.child('name').isString() && newData.child('name').val().length <= 200 && newData.child('n').isNumber()"
        }
      },
      "meta": {
        ".read": "(auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true)",
        ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')"
      },
      "deleted_trips": {
        ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        ".indexOn": [
          "deletedAt"
        ],
        "$id": {
          ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager') || ((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && ((!data.exists() && newData.child('createdBy').val() === root.child('test_env/roles/'+auth.uid+'/user').val()) || (!newData.exists() && data.child('createdBy').val() === root.child('test_env/roles/'+auth.uid+'/user').val())))"
        }
      },
      "drivers": {
        ".read": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')",
        ".write": "((auth != null && root.child('test_env/roles/'+auth.uid+'/active').val() === true) && root.child('test_env/roles/'+auth.uid+'/role').val() === 'manager')"
      }
    }
  }
}
